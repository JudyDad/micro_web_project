APP_NAME="Micro Projects"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8023
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Dedicated synthetic development database; use separate migration credentials.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=micro_projects_local
DB_USERNAME=micro_projects_web_local
DB_PASSWORD=

# Login/project pages require MySQL. Sessions/cache need no external service.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local
VITE_APP_NAME="${APP_NAME}"
